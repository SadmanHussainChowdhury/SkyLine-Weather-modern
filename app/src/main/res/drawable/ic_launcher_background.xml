<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Rich Midnight Sky Gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#0B132B" android:offset="0.0" />
                <item android:color="#1C2541" android:offset="0.5" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radial Glow behind Weather Elements -->
    <path android:pathData="M54,18 A36,36 0 1,0 54,90 A36,36 0 1,0 54,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="40"
                android:type="radial">
                <item android:color="#5038BDF8" android:offset="0.0" />
                <item android:color="#100284C7" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Soft Decorative Horizon Arc -->
    <path
        android:pathData="M 18,80 Q 54,74 90,80"
        android:strokeWidth="1.5"
        android:strokeColor="#3038BDF8"
        android:fillColor="#00000000" />
</vector>
